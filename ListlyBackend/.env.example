PORT=3000
HOST=0.0.0.0

# Requeridos para Auth y datos. La clave service_role nunca sale del backend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Conexión privada necesaria para reglas dinámicas y operaciones de escritura.
DATABASE_URL=
DATABASE_SCHEMA=public
METADATA_CACHE_TTL_MS=30000
VALIDATION_STATUS_ENABLED=true

# Nombres definidos por la migración en supabase/migrations.
SUPABASE_LISTS_TABLE=lists
SUPABASE_TASKS_TABLE=tasks

# Orígenes separados por coma para desarrollo. No usar * en producción.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
